    "test": "react-scripts test",
    "analyzer:setup": "node scripts/setup-analyzer.js",
    "analyzer:setup:gpu": "node scripts/setup-analyzer.js --gpu"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19",
    "concurrently": "^9.2.0"
  },
  "proxy": "http://localhost:3001"

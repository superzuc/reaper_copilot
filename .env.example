# Copia questo file in .env e compila.

# ─── Claude (Anthropic) ───────────────────────────────────────────────────
# La chiave API la chiede il copilot al primo avvio e la scrive qui da solo.
# Si crea su https://platform.claude.com/settings/keys (serve credito in Billing).
ANTHROPIC_API_KEY=

# Due livelli: un modello ESPERTO per mix, analisi e reference, e uno VELOCE (economico)
# per i comandi semplici. Con ROUTING=auto il copilot sceglie da solo e il veloce
# passa la mano all'esperto quando serve.
ROUTING=auto            # auto | strong (sempre esperto) | fast (sempre veloce)
LLM_MODEL=claude-sonnet-5-5
LLM_FAST_MODEL=claude-haiku-5-5

# Sforzo (quanto ragiona il modello): low | medium | high | xhigh | max
# Più sforzo = più token in uscita = più costo.
LLM_EFFORT=medium
LLM_FAST_EFFORT=low

# Classificatore iniziale: una chiamata brevissima al modello veloce decide chi lavora
# (veloce/esperto) e con quanto sforzo, in qualsiasi lingua. off = solo regole a parole chiave.
CLASSIFIER=auto
# STRONG_BUMP_STEPS=0      # >0: dopo questi passaggi l'esperto alza lo sforzo (sconsigliato: azzera la cache)

# Stima dei costi: per Sonnet 5.5 e Haiku 5.5 i prezzi sono già dentro. Per altri modelli
# Claude: USD per milione di token "input,output" dalla pagina prezzi di Anthropic.
# LLM_PRICE_PER_MTOK=2,10
# LLM_FAST_PRICE_PER_MTOK=0.1,0.5

# Cache dei prompt: 1h = istruzioni e comandi restano in cache un'ora
# (prima scrittura più cara, ma le pause tra un ascolto e l'altro non costano). 5m = default Anthropic.
CACHE_TTL=1h

# Facoltativi
# LLM_MAX_TOKENS=8192
# MAX_AGENT_STEPS=60
# FAST_MAX_STEPS=8      # dopo questi passaggi il veloce passa all'esperto

# ─── Separazione stem delle reference ─────────────────────────────────────
# SEPARATOR: local (Python su questo PC) | remote (servizio su un'altra macchina con GPU)
#            drive (Google Colab via cartella Google Drive) | off
SEPARATOR=local
# htdemucs_6s.yaml: voce, batteria, basso, chitarra, piano, altro (consigliato)
# htdemucs_ft.yaml: 4 stem, più preciso ma ~4 volte più lento
SEPARATOR_MODEL=htdemucs_6s.yaml
# Separa automaticamente ogni reference appena la carichi
AUTO_SEPARATE=true
# Python da usare se non trova analyzer/.venv (es. "py -3.13")
# PYTHON_BIN=

# remote: indirizzo del servizio (python analyzer/service.py --host 0.0.0.0 sulla macchina con GPU)
# SEPARATOR_URL=http://192.168.1.50:3002
# SEPARATOR_TOKEN=una-password-condivisa   (sul server: ANALYZER_TOKEN con lo stesso valore)

# drive: cartella di Google Drive per desktop (deve corrispondere a BASE nel notebook Colab)
# DRIVE_DIR=G:\Il mio Drive\reaper-copilot

# ─── Altro ────────────────────────────────────────────────────────────────
SERVER_PORT=3001
# REAPER_IPC_DIR=
# FFMPEG_PATH=

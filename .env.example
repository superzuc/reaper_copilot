# Copia questo file in .env e compila.

# ─── Modelli (LLM) ────────────────────────────────────────────────────────
# Due livelli: un modello ESPERTO per mix, analisi e reference, e uno VELOCE
# (economico) per i comandi semplici. Con ROUTING=auto il copilot sceglie da solo
# e il veloce passa la mano all'esperto quando serve.
ROUTING=auto            # auto | strong (sempre esperto) | fast (sempre veloce)

# Esperto
LLM_PROVIDER=anthropic  # anthropic | openai (= qualsiasi API compatibile OpenAI)
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# LLM_BASE_URL=         # solo per provider openai

# Veloce: i valori non impostati vengono presi dall'esperto (stesso provider e key)
LLM_FAST_MODEL=claude-haiku-5-5
# LLM_FAST_PROVIDER=
# LLM_FAST_API_KEY=
# LLM_FAST_BASE_URL=

# Stima dei costi (facoltativa): prezzo in USD per milione di token "input,output",
# copiato dalla pagina prezzi del provider. Il consumo si vede in data/usage.jsonl e su /api/usage
# LLM_PRICE_PER_MTOK=3,15
# LLM_FAST_PRICE_PER_MTOK=1,5

# Esempio: veloce su Gemini, esperto su Claude
#   LLM_FAST_PROVIDER=openai
#   LLM_FAST_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_FAST_API_KEY=<key di Google AI Studio>
#   LLM_FAST_MODEL=<modello Gemini Flash>

# Indirizzi dei provider compatibili OpenAI:
#   OpenRouter  https://openrouter.ai/api/v1   (modelli: https://openrouter.ai/models)
#   OpenAI      https://api.openai.com/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   DeepSeek    https://api.deepseek.com/v1
#   Ollama      http://localhost:11434/v1       (in locale, nessuna key)

# Facoltativi
# LLM_MAX_TOKENS=8192
# MAX_AGENT_STEPS=60
# FAST_MAX_STEPS=8      # dopo questi passaggi il veloce passa all'esperto

# ─── Separazione stem delle reference ─────────────────────────────────────
# SEPARATOR: local (Python su questo PC) | remote (servizio su un'altra macchina con GPU)
#            drive (Google Colab via cartella Google Drive) | off
SEPARATOR=local
# htdemucs_6s.yaml: voce, batteria, basso, chitarra, piano, altro (consigliato)
# htdemucs_ft.yaml: 4 stem, più preciso ma ~4 volte più lento
SEPARATOR_MODEL=htdemucs_6s.yaml
# Separa automaticamente ogni reference appena la carichi
AUTO_SEPARATE=true
# Python da usare se non trova analyzer/.venv (es. "py -3.13")
# PYTHON_BIN=

# remote: indirizzo del servizio (python analyzer/service.py --host 0.0.0.0 sulla macchina con GPU)
# SEPARATOR_URL=http://192.168.1.50:3002
# SEPARATOR_TOKEN=una-password-condivisa   (sul server: ANALYZER_TOKEN con lo stesso valore)

# drive: cartella di Google Drive per desktop (deve corrispondere a BASE nel notebook Colab)
# DRIVE_DIR=G:\Il mio Drive\reaper-copilot

# ─── Altro ────────────────────────────────────────────────────────────────
PORT=3001
# REAPER_IPC_DIR=
# FFMPEG_PATH=

# Copia questo file in .env e compila.

# ─── Modello (LLM) ─────────────────────────────────────────────────────────
# LLM_PROVIDER: anthropic | openai  (openai = qualsiasi API compatibile OpenAI)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Anthropic: claude-opus-5-5 (il migliore, costoso) | claude-sonnet-5-5 (equilibrato) | claude-haiku-5-5 (economico)
LLM_MODEL=claude-sonnet-5-5
# Solo per provider "openai": indirizzo dell'API
# LLM_BASE_URL=

# Esempi di provider compatibili (decommenta un blocco e metti la tua key/modello):
# OpenRouter (centinaia di modelli con una key: https://openrouter.ai/models)
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=<id del modello copiato da openrouter.ai/models>
# OpenAI
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.openai.com/v1
# Google Gemini
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# DeepSeek
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.deepseek.com/v1
# Ollama in locale (nessuna key; serve un modello che supporti i tool)
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://localhost:11434/v1

# Facoltativi
# LLM_MAX_TOKENS=8192
# MAX_AGENT_STEPS=60

# ─── Separazione stem delle reference ─────────────────────────────────────
# SEPARATOR: local (Python su questo PC) | remote (servizio su un'altra macchina con GPU)
#            drive (Google Colab via cartella Google Drive) | off
SEPARATOR=local
# htdemucs_6s.yaml: voce, batteria, basso, chitarra, piano, altro (consigliato)
# htdemucs_ft.yaml: 4 stem, più preciso ma ~4 volte più lento
SEPARATOR_MODEL=htdemucs_6s.yaml
# Separa automaticamente ogni reference appena la carichi
AUTO_SEPARATE=true
# Python da usare se non trova analyzer/.venv (es. "py -3.13")
# PYTHON_BIN=

# remote: indirizzo del servizio (python analyzer/service.py --host 0.0.0.0 sulla macchina con GPU)
# SEPARATOR_URL=http://192.168.1.50:3002
# SEPARATOR_TOKEN=una-password-condivisa   (sul server: ANALYZER_TOKEN con lo stesso valore)

# drive: cartella di Google Drive per desktop (deve corrispondere a BASE nel notebook Colab)
# DRIVE_DIR=G:\Il mio Drive\reaper-copilot

# ─── Altro ────────────────────────────────────────────────────────────────
PORT=3001
# REAPER_IPC_DIR=
# FFMPEG_PATH=
